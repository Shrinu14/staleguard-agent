# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# .env is git-ignored. NEVER commit real keys.
# ─────────────────────────────────────────────────────────────

# ── Bifrost gateway (read by the agent) ──────────────────────
BIFROST_BASE_URL=http://localhost:8080/v1
# Virtual keys. Bifrost reads these too (bifrost/config.json -> env.BIFROST_VK_*),
# so the agent and the gateway always agree. Any value starting with "sk-bf-".
# Generate one with:  echo "sk-bf-$(openssl rand -hex 24)"
# Normal repos: any configured provider.
BIFROST_VK_DEFAULT=
# Confidential repos: Ollama only (enforced by Bifrost).
BIFROST_VK_LOCAL=
# One-time token to create the Bifrost dashboard admin account.
# Generate with:  openssl rand -hex 32
BIFROST_SETUP_TOKEN=

# Fallback models tried in order when the primary fails (comma-separated,
# Bifrost "provider/model" ids). Empty = no fallback.
MODEL_FALLBACKS=

# ── Tavily (read by the agent) ───────────────────────────────
TAVILY_API_KEY=

# ── Models, in Bifrost's "provider/model" format ─────────────
# Only MODEL_LOCAL is required. Empty roles fall back to MODEL_LOCAL,
# so the project runs fully on Ollama out of the box.
MODEL_LOCAL=ollama/qwen2.5-coder:7b
MODEL_PLANNER=
MODEL_EDITOR=
MODEL_JUDGE=

# ── Budget ───────────────────────────────────────────────────
# Soft limit, checked by the agent BEFORE every call (per user, per calendar month).
# The hard limit is the Bifrost virtual-key budget in bifrost/config.json.
USER_BUDGET_USD=1.00
# Whose budget this is (ledger key). Empty = your OS login name.
STALEGUARD_USER=

# ── Provider keys (read ONLY by the Bifrost container) ───────
# The agent's Python code never loads these. Bifrost holds them,
# and the agent authenticates to Bifrost with virtual keys instead.
GEMINI_API_KEY=
GROQ_API_KEY=
